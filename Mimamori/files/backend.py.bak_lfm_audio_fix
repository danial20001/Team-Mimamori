# ── Find the GGUF file automatically ─────────────────────────────────────────
# Checks JP first, falls back to Instruct
def find_gguf():
    patterns = [
        "./models/JP/*.gguf",
        "./models/**/*.gguf",
        "./**/*.gguf",
    ]
    for pattern in patterns:
        matches = glob.glob(pattern, recursive=True)
        if matches:
            # prefer JP if available
            jp = [m for m in matches if "JP" in m]
            return jp[0] if jp else matches[0]
    raise FileNotFoundError("No .gguf file found. Run the download commands first.")

GGUF_PATH = find_gguf()
log.info(f"Loading model: {GGUF_PATH}")

# Runtime knobs: this is llama.cpp CPU by default, not Ryzen AI NPU.
# These settings make the local GGUF path noticeably snappier on Ryzen laptops.
CPU_THREADS = int(os.environ.get("LLAMA_THREADS", str(max(4, (os.cpu_count() or 8) - 2))))
CTX_SIZE = int(os.environ.get("LLAMA_CTX", "1024"))

llm = Llama(
    model_path=GGUF_PATH,
    n_ctx=CTX_SIZE,
    n_threads=CPU_THREADS,
    n_batch=256,
    n_gpu_layers=int(os.environ.get("LLAMA_GPU_LAYERS", "0")),
    use_mmap=True,
    use_mlock=False,
    verbose=False,
)
log.info("Model loaded. Running warm-up...")

# Warm-up call so first real request is fast
llm.create_chat_completion(
    messages=[{"role":"user","content":"hi"}],
    max_tokens=5,
)
log.info("Warm-up done. Server ready.")

# ── System prompt ─────────────────────────────────────────────────────────────
SYSTEM = """You are Mimamori, a Japanese phone-scam analysis engine.

ABSOLUTE LANGUAGE RULE:
- OUTPUT LANGUAGE MUST BE ENGLISH.
- Even if the transcript is Japanese, EVERY STRING VALUE in your JSON must be English.
- Never output Japanese characters in reasoning, latest_translation, scam_type, speaker_hint, recommended_action, or signals.
- latest_translation must be a natural English translation of the latest Japanese utterance only.
- reasoning must be one concise English sentence for a hackathon judge.

ABSOLUTE FORMAT RULE:
- Return ONLY valid JSON.
- No markdown.
- No prose before/after JSON.
- Use exactly these keys:
{
  "risk_score": <0-99>,
  "scam_type": "<fake_police|financial_pressure|romance_fraud|voice_clone|oreore_scam|none>",
  "signals": ["<authority|urgency|secrecy|money|impersonation>"],
  "reasoning": "<English sentence only>",
  "latest_translation": "<English translation only>",
  "speaker_hint": "<caller|user|unknown>",
  "recommended_action": "<monitor|show_caution|warn_user|warn_and_alert_family>"
}

Speaker role rules:
- caller = suspicious caller applying pressure, claiming authority, giving instructions, requesting LINE/ATM/bank/card/money.
- user = protected person asking questions, hesitating, verifying, or resisting.
- unknown = unclear.

Risk scoring:
0-39 = normal conversation.
40-69 = suspicious pressure.
70-84 = high risk with multiple scam signals.
85-99 = fake police, LINE isolation, arrest/prosecution pressure, money/card/ATM pressure, or confirmed scam.

Signals:
- authority: police, bank, prosecutor, government, official investigation.
- urgency: act now/today, emergency, immediate deadline.
- secrecy: tell no one, do not call family/bank, move to private LINE.
- money: transfer funds, withdraw cash, card, ATM, account, security deposit.
- impersonation: pretending to be police/family/bank/prosecutor/official.
"""

# ── Request / response ────────────────────────────────────────────────────────
class Req(BaseModel):
    transcript: str
    latest_utterance: Optional[str] = ""

def extract_json(raw: str) -> dict:
    """Extract JSON even if model adds extra text around it."""
    try:
        return json.loads(raw.strip())
    except:
        m = re.search(r'\{.*\}', raw, re.DOTALL)
        if m:
            try:
                return json.loads(m.group())
            except:
                pass
    return {}

FALLBACK = {
    "risk_score": 0,
    "scam_type": "none",
    "signals": [],
    "reasoning": "Analysis unavailable — lightweight local scorer active.",
    "latest_translation": "",
    "speaker_hint": "unknown",
    "recommended_action": "monitor",
}

_JP_RE = re.compile(r"[぀-ヿ㐀-鿿]")

def has_japanese(value: Any) -> bool:
    return bool(_JP_RE.search(str(value or "")))

def english_fallback_reason(data: dict) -> str:
    signals = set(data.get("signals") or [])
    scam_type = data.get("scam_type", "none")
    if "authority" in signals and ("secrecy" in signals or "urgency" in signals):
        return "The caller is using official authority and pressure tactics to isolate the victim."
    if "money" in signals and "urgency" in signals:
        return "The caller is creating urgent financial pressure, which is a strong scam pattern."
    if scam_type in {"fake_police", "oreore_scam", "financial_pressure"}:
        return "The conversation matches a known phone-scam pattern and should be treated as high risk."
    return "The model is monitoring the transcript for scam pressure and manipulation signals."

def repair_english_fields(data: dict, transcript: str, latest_utterance: str) -> dict:
    """If the JP model ignores English-only instructions, run a tiny repair pass.
    If repair still fails, remove Japanese from judge-visible English fields.
    """
    needs_repair = has_japanese(data.get("reasoning")) or has_japanese(data.get("latest_translation"))
    if not needs_repair:
        return data
    try:
        repair_prompt = f"""Convert this analysis to ENGLISH ONLY JSON. Do not output Japanese characters.
Keep the same risk_score, scam_type, signals, speaker_hint, and recommended_action.
Translate latest_translation to English. Rewrite reasoning in English.

Original JSON:
{json.dumps(data, ensure_ascii=False)}

Latest Japanese utterance to translate:
{latest_utterance}
"""
        response = llm.create_chat_completion(
            messages=[
                {"role": "system", "content": "You translate and repair JSON. Output English-only valid JSON. No Japanese characters. No markdown."},
                {"role": "user", "content": repair_prompt},
            ],
            max_tokens=180,
            temperature=0.0,
            repeat_penalty=1.08,
        )
        repaired = extract_json(response["choices"][0]["message"]["content"])
        if repaired:
            for k in ["reasoning", "latest_translation", "speaker_hint", "recommended_action", "scam_type", "signals"]:
                if k in repaired:
                    data[k] = repaired[k]
    except Exception as e:
        log.warning(f"English repair failed: {e}")

    # Last-resort: never show Japanese in English fields during the demo.
    if has_japanese(data.get("reasoning")):
        data["reasoning"] = english_fallback_reason(data)
    if has_japanese(data.get("latest_translation")):
        data["latest_translation"] = "English translation pending."
    return data


# ── Fast path: keep the demo responsive while the local LFM is slow ───────────
# LFM on this setup runs through llama.cpp CPU by default. Ryzen AI hardware will
# not automatically accelerate GGUF unless you use an NPU-specific runtime. To
# avoid 10-15s pauses per bubble, the backend returns a deterministic fast result
# for every segment and only refreshes LFM reasoning occasionally.
USE_LFM = os.environ.get("USE_LFM", "1") != "0"
LFM_MIN_INTERVAL = float(os.environ.get("LFM_MIN_INTERVAL", "7.5"))
LFM_MAX_CHARS = int(os.environ.get("LFM_MAX_CHARS", "1400"))
_lfm_last_time = 0.0
_lfm_last_data: Optional[dict] = None
_lfm_cache: Dict[str, dict] = {}

FAST_TERMS = {
    "authority": ["警察", "警視庁", "生活安全", "検察", "裁判", "逮捕", "容疑", "捜査", "職員", "銀行", "郵便局"],
    "urgency": ["今すぐ", "今日中", "至急", "緊急", "すぐ", "急", "逮捕", "起訴"],
    "secrecy": ["誰にも", "内緒", "秘密", "家族", "言わない", "LINE", "ライン", "電話を切ら", "連絡しない"],
    "money": ["お金", "現金", "振り込", "振込", "口座", "キャッシュカード", "暗証番号", "ATM", "銀行", "資金", "残高"],
    "impersonation": ["俺", "息子", "警察", "警視庁", "銀行", "検察", "職員", "名乗"],
}

SIGNAL_WEIGHTS = {"authority": 30, "urgency": 18, "secrecy": 24, "money": 28, "impersonation": 16}

TRANS_RULES = [
    ("警察", "The caller is referring to the police."),
    ("警視庁", "The caller claims to be from the Tokyo Metropolitan Police."),
    ("生活安全", "The caller claims to be from a police public-safety division."),
    ("逮捕", "The caller mentions an arrest."),
    ("容疑", "The caller says there is suspicion of a crime."),
    ("捜査", "The caller refers to an investigation."),
    ("検察", "The caller mentions prosecutors."),
    ("LINE", "The caller is trying to move the conversation to LINE."),
    ("ライン", "The caller is trying to move the conversation to LINE."),
    ("キャッシュカード", "The caller mentions a cash card."),
    ("暗証番号", "The caller mentions a PIN number."),
    ("口座", "The caller mentions a bank account."),
    ("銀行", "The caller mentions a bank."),
    ("郵便局", "The caller mentions the post office."),
    ("振り込", "The caller is talking about transferring money."),
    ("振込", "The caller is talking about a bank transfer."),
    ("お金", "The caller is talking about money."),
    ("現金", "The caller is talking about cash."),
    ("今日中", "The caller creates a same-day deadline."),
    ("今すぐ", "The caller is creating immediate pressure."),
    ("家族", "The caller refers to family involvement or verification."),
    ("内緒", "The caller asks for secrecy."),
    ("誰にも", "The caller says not to tell anyone."),
]

def _contains_any(text: str, words: List[str]) -> bool:
    return any(w.lower() in text.lower() for w in words)

def fast_translate_latest(latest: str) -> str:
    latest = (latest or "").strip()
    if not latest:
        return ""
    hits = []
    for key, eng in TRANS_RULES:
        if key in latest and eng not in hits:
            hits.append(eng)
    if hits:
        # Keep it short so the bubble appears quickly and cleanly.
        return " ".join(hits[:2])
    # Safe fallback: do not show broken Japanese as English.
    return "Translation pending — the local LFM is checking this utterance."

def fast_analyze(transcript: str, latest: str = "") -> dict:
    text = (transcript or "") + "\n" + (latest or "")
    signals = []
    score = 0
    for sig, terms in FAST_TERMS.items():
        if _contains_any(text, terms):
            signals.append(sig)
            score += SIGNAL_WEIGHTS[sig]
    if "authority" in signals and "secrecy" in signals:
        score += 12
    if "authority" in signals and "urgency" in signals:
        score += 10
    if "money" in signals and "urgency" in signals:
        score += 10
    score = min(score, 95)

    if "authority" in signals and ("secrecy" in signals or "urgency" in signals):
        scam_type = "fake_police"
    elif "impersonation" in signals and "money" in signals:
        scam_type = "oreore_scam"
    elif "money" in signals:
        scam_type = "financial_pressure"
    else:
        scam_type = "none"

    latest_text = latest or ""
    if _contains_any(latest_text, ["ですか", "いいですか", "確認", "どうした", "誰", "本当"]):
        speaker = "user"
    elif _contains_any(latest_text, FAST_TERMS["authority"] + FAST_TERMS["money"] + FAST_TERMS["secrecy"] + FAST_TERMS["urgency"]):
        speaker = "caller"
    else:
        speaker = "unknown"

    if score >= 85:
        action = "warn_and_alert_family"
        reasoning = "The call shows a high-risk scam pattern: authority pressure, isolation, and potential financial harm."
    elif score >= 70:
        action = "warn_user"
        reasoning = "The caller is using suspicious pressure tactics and the system is watching for escalation."
    elif score >= 40:
        action = "show_caution"
        reasoning = "Early scam indicators are present, so the system is raising caution while monitoring the call."
    else:
        action = "monitor"
        reasoning = "The model is monitoring the call for scam pressure, isolation, and financial-risk signals."

    return {
        "risk_score": score,
        "scam_type": scam_type,
        "signals": signals,
        "reasoning": reasoning,
        "latest_translation": fast_translate_latest(latest),
        "speaker_hint": speaker,
        "recommended_action": action,
        "latency_ms": 0,
        "source": "fast_local",
    }

def _recent_context(transcript: str) -> str:
    transcript = (transcript or "").strip()
    if len(transcript) <= LFM_MAX_CHARS:
        return transcript
    return transcript[-LFM_MAX_CHARS:]

def run_lfm_analysis(transcript: str, latest_utterance: str = "") -> dict:
    """Run the local LFM/llama.cpp model once and return normalized JSON."""
    t0 = time.time()
    response = llm.create_chat_completion(
        messages=[
            {"role": "system", "content": SYSTEM},
            {"role": "user",   "content": f"Recent phone call transcript context:\n{_recent_context(transcript)}\n\nLatest utterance to translate and classify:\n{latest_utterance or ''}"}
        ],
        max_tokens=int(os.environ.get("LFM_MAX_TOKENS", "120")),
        temperature=0.0,
        repeat_penalty=1.05,
    )
    raw = response["choices"][0]["message"]["content"]
    ms  = int((time.time() - t0) * 1000)
    log.info(f"[{ms}ms] {raw[:120]}")

    data = extract_json(raw)
    if not data:
        log.warning("JSON parse failed, using fallback")
        return {**FALLBACK, "latency_ms": ms}

    data.setdefault("risk_score", 0)
    data.setdefault("scam_type", "none")
    data.setdefault("signals", [])
    data.setdefault("reasoning", "Analysis complete.")
    data.setdefault("latest_translation", "")
    data.setdefault("speaker_hint", "unknown")
    data.setdefault("recommended_action", "monitor")
    data = repair_english_fields(data, transcript, latest_utterance)
    data["latency_ms"] = ms
    return data

# ── Main endpoint ─────────────────────────────────────────────────────────────
@app.post("/api/analyze")
async def analyze(req: Req):
    """Responsive analysis endpoint.

    It returns a fast English result immediately for every transcript update.
    The heavier LFM model is used only periodically and cached. This keeps
    translation/reasoning responsive during the synced audio demo.
    """
    global _lfm_last_time, _lfm_last_data
    transcript = (req.transcript or "").strip()
    latest = req.latest_utterance or ""
    if not transcript:
        return {**FALLBACK, "latency_ms": 0, "source": "empty"}

    fast = fast_analyze(transcript, latest)
    if not USE_LFM:
        return fast

    now = time.time()
    cache_key = str(hash((_recent_context(transcript), latest)))

    # If LFM was called very recently, keep UI fast and return local result.
    # Merge the last stronger LFM result where useful, but keep latest fast translation.
    if _lfm_last_data and (now - _lfm_last_time) < LFM_MIN_INTERVAL:
        merged = dict(fast)
        if int(_lfm_last_data.get("risk_score", 0)) >= int(fast.get("risk_score", 0)):
            for k in ["risk_score", "scam_type", "signals", "reasoning", "recommended_action"]:
                merged[k] = _lfm_last_data.get(k, merged.get(k))
        merged["latest_translation"] = fast.get("latest_translation", "") or _lfm_last_data.get("latest_translation", "")
        merged["speaker_hint"] = fast.get("speaker_hint") or _lfm_last_data.get("speaker_hint", "unknown")
        merged["source"] = "fast_cached_lfm"
        merged["latency_ms"] = 1
        return merged

    if cache_key in _lfm_cache:
        cached = dict(_lfm_cache[cache_key])
        cached["source"] = "lfm_cache"
        return cached

    t0 = time.time()
    try:
        data = run_lfm_analysis(transcript, latest)
        data["source"] = "lfm"
        _lfm_last_time = time.time()
        _lfm_last_data = data
        _lfm_cache[cache_key] = data
        # Never let LFM make the demo look weaker/slower than fast detection.
        if int(fast.get("risk_score", 0)) > int(data.get("risk_score", 0)):
            data["risk_score"] = fast["risk_score"]
            data["signals"] = sorted(set((data.get("signals") or []) + fast.get("signals", [])))
            data["recommended_action"] = fast["recommended_action"]
        if not data.get("latest_translation") or has_japanese(data.get("latest_translation")):
            data["latest_translation"] = fast.get("latest_translation", "")
        return data
    except Exception as e:
        log.error(f"Model error, using fast local result: {e}")
        fast["latency_ms"] = int((time.time()-t0)*1000)
        return fast



