# ── Optional Liquid Audio JP ASR path ─────────────────────────────────────────
# This plugs LiquidAI/LFM2.5-Audio-1.5B-JP-GGUF into the uploaded-audio path.
# It is OFF by default so the stable Whisper path still works. Enable with:
#   set LFM_AUDIO_ASR=1
#   set LFM_AUDIO_DIR=models\audio_jp
#   set LFM_AUDIO_CLI=path\to\llama-liquid-audio-cli.exe   (optional if in PATH)

def _which_exe(name: str) -> Optional[str]:
    found = shutil.which(name)
    return found

def find_lfm_audio_cli() -> Optional[str]:
    env = os.environ.get("LFM_AUDIO_CLI", "").strip().strip('"')
    candidates = []
    if env:
        candidates.append(env)
    base = Path(os.environ.get("LFM_AUDIO_DIR", "models/audio_jp"))
    candidates += [
        str(base / "runners" / "llama-liquid-audio-cli.exe"),
        str(base / "runners" / "llama-liquid-audio-cli"),
        str(base / "llama-liquid-audio-cli.exe"),
        str(base / "llama-liquid-audio-cli"),
    ]
    path_hit = _which_exe("llama-liquid-audio-cli.exe") or _which_exe("llama-liquid-audio-cli")
    if path_hit:
        candidates.append(path_hit)
    for c in candidates:
        if c and Path(c).exists():
            return c
    return None

def _first_file(patterns: List[str]) -> Optional[str]:
    base = Path(os.environ.get("LFM_AUDIO_DIR", "models/audio_jp"))
    for pat in patterns:
        hits = sorted(base.glob(pat))
        if hits:
            return str(hits[0])
    return None

def find_lfm_audio_files() -> Dict[str, Optional[str]]:
    # Prefer Q4_0 for speed. User can override by putting another quant in LFM_AUDIO_QUANT.
    q = os.environ.get("LFM_AUDIO_QUANT", "Q4_0")
    return {
        "cli": find_lfm_audio_cli(),
        "model": _first_file([f"LFM2.5-Audio-1.5B-JP-{q}.gguf", f"*Audio*JP*{q}.gguf"]),
        "mmproj": _first_file([f"mmproj-LFM2.5-Audio-1.5B-JP-{q}.gguf", f"mmproj-*Audio*JP*{q}.gguf"]),
        "vocoder": _first_file([f"vocoder-LFM2.5-Audio-1.5B-JP-{q}.gguf", f"vocoder-*Audio*JP*{q}.gguf"]),
        "tokenizer": _first_file([f"tokenizer-LFM2.5-Audio-1.5B-JP-{q}.gguf", f"tokenizer-*Audio*JP*{q}.gguf"]),
    }

def ffprobe_duration(path: str) -> Optional[float]:
    try:
        out = subprocess.check_output([
            "ffprobe", "-v", "error", "-show_entries", "format=duration",
            "-of", "default=noprint_wrappers=1:nokey=1", path
        ], stderr=subprocess.STDOUT, text=True, timeout=10).strip()
        return float(out) if out else None
    except Exception:
        return None

def ensure_wav_for_lfm(input_path: str) -> str:
    # LFM audio runner examples use wav. Convert when ffmpeg exists; otherwise try original.
    if input_path.lower().endswith(".wav"):
        return input_path
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        log.warning("ffmpeg not found; passing original audio to Liquid Audio runner")
        return input_path
    out_path = tempfile.NamedTemporaryFile(delete=False, suffix=".wav").name
    subprocess.check_call([
        ffmpeg, "-y", "-i", input_path, "-ac", "1", "-ar", "16000", out_path
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return out_path

def clean_lfm_audio_text(raw: str) -> str:
    raw = re.sub(r"\x1b\[[0-9;]*m", "", raw or "")
    # Remove common logs while keeping Japanese/English content.
    lines = []
    for line in raw.splitlines():
        t = line.strip()
        if not t:
            continue
        low = t.lower()
        if any(x in low for x in ["llama_", "ggml", "sampler", "system_info", "load_", "main:", "usage:"]):
            continue
        lines.append(t)
    text = " ".join(lines).strip()
    # Keep from first Japanese character if logs precede output.
    m = re.search(r"[ぁ-んァ-ン一-龥]", text)
    if m:
        text = text[m.start():]
    return text.strip()

def split_lfm_transcript_to_segments(text: str, duration: Optional[float]) -> List[Dict[str, Any]]:
    text = (text or "").strip()
    if not text:
        return []
    # Split on Japanese/English sentence boundaries, but avoid tiny fragments.
    parts = [p.strip() for p in re.split(r"(?<=[。！？!?])\s+|[\r\n]+", text) if p.strip()]
    if len(parts) <= 1:
        parts = [p.strip() for p in re.split(r"(?<=[。！？!?])", text) if p.strip()]
    if not parts:
        parts = [text]
    total = float(duration or max(2.0 * len(parts), 2.0))
    seg_len = max(total / max(len(parts), 1), 1.0)
    segments = []
    for i, part in enumerate(parts):
        start = round(i * seg_len, 2)
        end = round(min((i + 1) * seg_len, total), 2)
        segments.append({"start": start, "end": end, "text": part, "en": ""})
    return segments

def run_lfm_audio_asr(input_path: str) -> Dict[str, Any]:
    files = find_lfm_audio_files()
    missing = [k for k, v in files.items() if not v]
    if missing:
        raise RuntimeError(f"Liquid Audio files missing: {missing}. Set LFM_AUDIO_DIR or download Q4_0 files + runner.")
    wav_path = ensure_wav_for_lfm(input_path)
    cleanup_wav = wav_path != input_path
    try:
        cmd = [
            files["cli"],
            "-m", files["model"],
            "-mm", files["mmproj"],
            "-mv", files["vocoder"],
            "--tts-speaker-file", files["tokenizer"],
            "-sys", os.environ.get("LFM_AUDIO_SYS", "Perform ASR in Japanese. Output only the Japanese transcript text. No explanation."),
            "--audio", wav_path,
        ]
        timeout = int(os.environ.get("LFM_AUDIO_TIMEOUT", "180"))
        log.info("Running Liquid Audio ASR: " + " ".join([str(x) for x in cmd[:2]]) + " ...")
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        raw = (proc.stdout or "") + "\n" + (proc.stderr or "")
        if proc.returncode != 0:
            raise RuntimeError(f"Liquid Audio runner returned {proc.returncode}: {raw[-1200:]}")
        text = clean_lfm_audio_text(raw)
        if not text:
            raise RuntimeError("Liquid Audio returned empty transcript")
        dur = ffprobe_duration(input_path)
        segments = split_lfm_transcript_to_segments(text, dur)
        return {"text": text, "segments": segments, "duration": dur, "files": files}
    finally:
        if cleanup_wav:
            try:
                os.remove(wav_path)
            except Exception:
                pass

# ── Direct uploaded-audio transcription ──────────────────────────────────────
# This avoids the unreliable "play audio through speakers and hope Web Speech hears it" route.
# Install once: pip install faster-whisper python-multipart
_whisper_model = None

def get_whisper_model():
    global _whisper_model
    if _whisper_model is not None:
        return _whisper_model
    try:
        from faster_whisper import WhisperModel
    except Exception as e:
        raise RuntimeError("faster-whisper is not installed. Run: pip install faster-whisper python-multipart") from e

    model_name = os.environ.get("WHISPER_MODEL", "base")  # base = faster; small = better Japanese
    device = os.environ.get("WHISPER_DEVICE", "cpu")
    compute_type = os.environ.get("WHISPER_COMPUTE", "int8")
    log.info(f"Loading Whisper ASR model: {model_name} ({device}, {compute_type})")
    _whisper_model = WhisperModel(model_name, device=device, compute_type=compute_type)
    return _whisper_model

@app.on_event("startup")
def preload_asr_model():
    """Pre-load Whisper during backend startup so the first uploaded audio does not wait 2-3 minutes.
    This makes uvicorn startup slower, but the demo itself smoother.
    """
    try:
        get_whisper_model()
        log.info("Whisper ASR warm-up done. Upload transcription will be faster during demo.")
    except Exception as e:
        log.warning(f"Whisper ASR preload skipped/failed: {e}")

@app.post("/api/transcribe-audio")
async def transcribe_audio(file: UploadFile = File(...)):
    """Transcribe uploaded audio ONLY.

    Important: this endpoint intentionally does NOT run the LFM text model.
    The frontend first renders ASR segments, then calls /api/analyze separately.
    That prevents the transcript from appearing and then disappearing while the
    slower language model is still thinking.
    """
    t0 = time.time()
    suffix = os.path.splitext(file.filename or "audio.wav")[1] or ".wav"
    tmp_path = None
    try:
        with tempfile.NamedTemporaryFile(delete=False, suffix=suffix) as tmp:
            tmp_path = tmp.name
            shutil.copyfileobj(file.file, tmp)

        # Optional Path A: Liquid Audio JP directly reads the uploaded audio.
        # If it fails, we fall back to the stable Whisper ASR path.
        if os.environ.get("LFM_AUDIO_ASR", "0") == "1":
            try:
                lfm_audio = run_lfm_audio_asr(tmp_path)
                segments = lfm_audio["segments"]
                full_text = lfm_audio["text"]
                latency = int((time.time() - t0) * 1000)
                log.info(f"Liquid Audio ASR complete: {len(segments)} segments in {latency}ms")
                return {
                    "ok": True,
                    "mode": "liquid_audio_jp_asr_synced",
                    "filename": file.filename,
                    "language": "ja",
                    "duration": lfm_audio.get("duration"),
                    "segments": segments,
                    "translated_segments": [],
                    "transcript": full_text,
                    "translation_source": "lfm_text_or_fast_fallback",
                    "audio_model": "LiquidAI/LFM2.5-Audio-1.5B-JP-GGUF",
                    "latency_ms": latency,
                }
            except Exception as e:
                log.warning(f"Liquid Audio ASR failed; falling back to Whisper: {e}")

        model = get_whisper_model()
        # Pass 1: Japanese ASR for the visible Japanese transcript.
        segments_iter, info = model.transcribe(
            tmp_path,
            language="ja",
            task="transcribe",
            vad_filter=True,
            beam_size=5,
            condition_on_previous_text=False,
        )

        segments = []
        full_parts = []
        for seg in segments_iter:
            text = (seg.text or "").strip()
            if not text:
                continue
            item = {
                "start": round(float(seg.start), 2),
                "end": round(float(seg.end), 2),
                "text": text,
                "en": "",
            }
            segments.append(item)
            full_parts.append(text)

        # Pass 2: Whisper's built-in Japanese -> English translation.
        # This is much faster/reliable for demo subtitles than asking the local
        # LFM to translate every bubble. It runs during pre-processing, so when
        # you press Play, English subtitles are already ready.
        translate_enabled = os.environ.get("WHISPER_TRANSLATE", "1") != "0"
        translated_segments = []
        if translate_enabled and segments:
            try:
                tr_iter, _ = model.transcribe(
                    tmp_path,
                    language="ja",
                    task="translate",
                    vad_filter=True,
                    beam_size=5,
                    condition_on_previous_text=False,
                )
                for tr in tr_iter:
                    txt = (tr.text or "").strip()
                    if txt:
                        translated_segments.append({
                            "start": round(float(tr.start), 2),
                            "end": round(float(tr.end), 2),
                            "text": txt,
                        })
                # Align English to Japanese by temporal overlap / nearest start.
                for item in segments:
                    best = None
                    best_score = -1e9
                    a0, a1 = float(item["start"]), float(item["end"] or item["start"])
                    for tr in translated_segments:
                        b0, b1 = float(tr["start"]), float(tr["end"] or tr["start"])
                        overlap = max(0.0, min(a1, b1) - max(a0, b0))
                        distance = abs(a0 - b0)
                        score = overlap * 10.0 - distance
                        if score > best_score:
                            best_score = score
                            best = tr
                    if best and best_score > -3.0:
                        item["en"] = best["text"]
            except Exception as e:
                log.warning(f"Whisper translation pass failed; UI will use LFM/fast fallback translation: {e}")

        latency = int((time.time() - t0) * 1000)
        log.info(f"ASR complete: {len(segments)} segments, translations={sum(1 for s in segments if s.get('en'))} in {latency}ms")
        return {
            "ok": True,
            "mode": "direct_file_asr_synced_whisper_translate",
            "filename": file.filename,
            "language": getattr(info, "language", "ja"),
            "duration": getattr(info, "duration", None),
            "segments": segments,
            "translated_segments": translated_segments,
            "transcript": "\n".join(full_parts),
            "translation_source": "whisper_translate" if translate_enabled else "lfm_or_fast_fallback",
            "latency_ms": latency,
        }
    except Exception as e:
        log.error(f"Audio transcription failed: {e}")
        return {
            "ok": False,
            "error": str(e),
            "hint": "For uploaded audio, install faster-whisper and python-multipart, then restart uvicorn. Also ensure ffmpeg is installed/available.",
            "segments": [],
            "latency_ms": int((time.time()-t0)*1000),
        }
    finally:
        if tmp_path and os.path.exists(tmp_path):
            try:
                os.remove(tmp_path)
            except Exception:
                pass

